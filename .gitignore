# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Web
node_modules/
web/dist/
web/src/wasm-pkg/
.claude/worktrees/

# Flump studio build outputs
studio/out/
__pycache__/

# Local copies of source papers (see docs/papers.md); never committed
papers/

# Survey runs by prefix (--only …); the full run's results.json, table.md and triage.md are tracked
survey/out/results-*.json

# Emergent polarity raw sessions, resolved authority and run logs remain local
survey/out/polarity-*

# GeoSim raw sessions, reference dependencies and execution receipts stay local
survey/out/geosim-*

# Democratic-peace scratch, runtime-only and registered evidence.
survey/out/democratic-peace-*

# Local memoryless-pricing exploratory traces and verification evidence
survey/out/collusion-memoryless-20261010/

# Local cloned-state memoryless component-refresh evidence
survey/out/collusion-memoryless-components-20261010/

# Local primary-source and saved-input collusion scientific audit
survey/out/collusion-scientific-audit-20261010/

# Local certified frozen pricing policy audit evidence
survey/out/collusion-policy-audit-20261011/
